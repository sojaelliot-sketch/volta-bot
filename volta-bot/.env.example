BOT_NAME=VoltaBot
SESSION_DIR=./sessions
DATA_DIR=./data
LOG_LEVEL=info
NODE_ENV=development

# Set to "true" to log in with a pairing code instead of scanning a QR
USE_PAIRING_CODE=true
# Your WhatsApp number in international format, no + or spaces.
# If left empty when USE_PAIRING_CODE=true, the terminal will prompt you at startup.
PHONE_NUMBER=
# Local numbers like 08012345678 get this country code added automatically.
DEFAULT_COUNTRY_CODE=234
# Baileys' own logging. Set to "debug" when diagnosing connection/pairing problems.
BAILEYS_LOG_LEVEL=silent
# Optional: force a WhatsApp Web version, e.g. 2.3000.1042466098 (only if 405 errors persist)
WA_VERSION=
